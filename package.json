{
  "name": "vantage",
  "version": "1.0.0",
  "description": "Website security posture scanner: TLS, headers, CSP, cookies, CORS, exposed files and DNS, graded A+ to F — with a CLI and a React console.",
  "type": "module",
  "license": "MIT",
  "author": "Betülay Durmuş <betulaydurmuss@icloud.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/betulaydurmuss/vantage.git"
  },
  "bin": {
    "vantage": "bin/vantage.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node bin/vantage.js serve --dev",
    "build": "vite build",
    "start": "node bin/vantage.js serve",
    "scan": "node bin/vantage.js scan",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "prepack": "vite build"
  },
  "dependencies": {
    "@peculiar/x509": "^2.1.0",
    "express": "^5.2.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "vite": "^8.3.2"
  },
  "files": [
    "bin",
    "server",
    "dist"
  ],
  "keywords": [
    "security",
    "scanner",
    "tls",
    "csp",
    "security-headers",
    "cors",
    "owasp",
    "react",
    "cli"
  ],
  "homepage": "https://github.com/betulaydurmuss/vantage#readme",
  "bugs": {
    "url": "https://github.com/betulaydurmuss/vantage/issues"
  }
}
